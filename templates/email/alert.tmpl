---
name: alert
channel: email
subject: {{.alert_title}}
---
<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>Alert</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
	<h1>{{.alert_title}}</h1>
	<p>{{.alert_message}}</p>
	{{if .alert_details}}
	<p><strong>Details:</strong></p>
	<p>{{.alert_details}}</p>
	{{end}}
	{{if .action_url}}
	<p><a href="{{.action_url}}" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block;">View Details</a></p>
	{{end}}
	<p>Best regards,<br>The {{.app_name}} Team</p>
</body>
</html>
